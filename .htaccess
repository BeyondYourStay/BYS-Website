RewriteEngine On

# Bilingual restructure (Aug 2026): old English-at-root URLs now redirect to
# their /en/ counterpart. Dutch content took over the old English paths that
# had a Dutch-friendly slug already (cases, journal index, studio, contact);
# the rest moved to native Dutch slugs, so those old English paths redirect
# to /en/ too, never to the new Dutch page (different content, not a synonym).
Redirect 301 /about/ /en/about/
Redirect 301 /services/ /en/services/
Redirect 301 /packages/ /en/packages/
Redirect 301 /cases/ /en/cases/
Redirect 301 /journal/hotel-marketing-strategy/ /en/journal/hotel-marketing-strategy/
Redirect 301 /journal/hospitality-marketing-strategy/ /en/journal/hospitality-marketing-strategy/
Redirect 301 /journal/ /en/journal/
Redirect 301 /studio/ /en/studio/
Redirect 301 /contact/ /en/contact/
Redirect 301 /careers/ /en/careers/
Redirect 301 /privacy/ /en/privacy/
Redirect 301 /terms/ /en/terms/
